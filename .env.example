# Prod-Konfiguration: nach .env kopieren und ausfüllen (cp .env.example .env)

# Tailscale → Settings → Keys → "Generate auth key" (nicht reusable, nicht ephemeral)
TS_AUTHKEY=tskey-auth-...

# Zufälliger String, z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Ohne diesen Code ist keine Registrierung möglich; an die Gruppe weitergeben
REGISTER_CODE=

# Benutzernamen, die bei Registrierung/Login automatisch Admin werden
ADMIN_USERS=cosh
