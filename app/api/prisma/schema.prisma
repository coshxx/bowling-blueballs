generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  /// Anzeigeform, wie bei der Registrierung eingegeben
  username       String
  /// Kleingeschrieben, für eindeutige Namen unabhängig von Groß-/Kleinschreibung
  usernameKey    String       @unique
  passwordHash   String
  isAdmin        Boolean      @default(false)
  /// Wird beim Passwort-Reset erhöht und macht bestehende Sessions ungültig
  sessionVersion Int          @default(0)
  /// PayPal.Me-Name für Zahlungslinks (paypal.me/<name>/<betrag>EUR)
  paypalMe       String?
  createdAt      DateTime     @default(now())
  /// Letzte eingeloggte Anfrage, höchstens alle 5 Minuten aktualisiert
  lastSeenAt     DateTime?
  /// Dateiname in DATA_DIR/avatars (256×256 WebP); neuer Zufallsname bei jedem Upload
  avatarFile     String?
  memberships    Membership[]
  uploads        Entry[]      @relation("uploader")
  approvals      Entry[]      @relation("approver")
  players        Player[]
  evenings       Evening[]
  paidMarks      EveningAttendee[]
}

model Group {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  entries     Entry[]
  players     Player[]
  aliases     PlayerAlias[]
  evenings    Evening[]
}

model Membership {
  userId    Int
  groupId   Int
  canUpload Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Player {
  id        Int           @id @default(autoincrement())
  groupId   Int
  name      String
  /// Optionale Verknüpfung mit einem Benutzerkonto
  userId    Int?
  /// Team aus Teamspielen: eigene Statistik, nie mit Konto verknüpft, nicht bei Abenden
  isTeam    Boolean       @default(false)
  createdAt DateTime      @default(now())
  group     Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  aliases      PlayerAlias[]
  games        Game[]
  consumptions Consumption[]
  shares       ConsumptionShare[]
  attendances  EveningAttendee[]
  receipts     Evening[]          @relation("recipient")

  @@unique([groupId, name])
}

/// Anzeigename auf der Bahn (z. B. "EL TOM.") → Spieler; normalisiert in Großbuchstaben
model PlayerAlias {
  id       Int    @id @default(autoincrement())
  groupId  Int
  alias    String
  playerId Int
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, alias])
}

model Entry {
  id           Int       @id @default(autoincrement())
  groupId      Int
  uploaderId   Int?
  /// Dateiname in DATA_DIR/images; null bei importierten Einträgen ohne Foto
  imageFile    String?
  imageType    String?
  /// Herkunft importierter Spiele (z. B. "import-2025"); null bei hochgeladenen Fotos
  source       String?
  /// Spieldatum YYYY-MM-DD
  playedOn     String
  /// "pending" | "running" | "review" | "approved" | "failed"
  status       String    @default("pending")
  /// Zwischenstände passten nach der Analyse nicht vollständig
  uncertain    Boolean   @default(false)
  /// Teamspiel: jede Zeile ist ein Team (Player.isTeam), wird bei der Freigabe gesetzt
  isTeamGame   Boolean   @default(false)
  /// Rohergebnis des Parsers: {"players": [{"name", "frames"}]}
  result       String?
  /// Vom Modell gelesene Zwischenstände pro Spieler (gleiche Reihenfolge wie result.players)
  scores       String?
  /// JSON-Array mit Abweichungen zu den angezeigten Zwischenständen
  problems     String?
  error        String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
  approvedById Int?
  approvedAt   DateTime?
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader     User?     @relation("uploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  approvedBy   User?     @relation("approver", fields: [approvedById], references: [id], onDelete: SetNull)
  games        Game[]

  @@index([status, createdAt])
  @@index([groupId, createdAt])
}

/// Ein freigegebenes Spiel eines Spielers; entsteht bei der Freigabe, Grundlage der Statistik
model Game {
  id          Int     @id @default(autoincrement())
  entryId     Int
  playerId    Int
  /// Zeile auf der Anzeige (0 = oben)
  position    Int
  /// Name, wie er auf der Anzeige stand
  displayName String
  /// JSON: [[9, 1], [10], ...]
  frames      String
  score       Int
  complete    Boolean
  /// Kopie von Entry.playedOn für die Statistik
  playedOn    String
  entry       Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([playerId])
}

/// Bowlingcenter, Kneipe o. Ä.; global für alle Gruppen
model Location {
  id        Int        @id @default(autoincrement())
  name      String
  /// Normalisiert (Kleinbuchstaben, einfache Leerzeichen), für eindeutige Namen
  nameKey   String     @unique
  createdAt DateTime   @default(now())
  menuItems MenuItem[]
  evenings  Evening[]
}

/// Artikel auf der Karte einer Location; neue Artikel entstehen beim Eintragen von Verzehr
model MenuItem {
  id           Int           @id @default(autoincrement())
  locationId   Int
  name         String
  /// Normalisiert wie Location.nameKey
  nameKey      String
  /// Zuletzt verwendeter Einzelpreis in Cent, Vorschlag beim nächsten Eintragen
  priceCents   Int
  /// Ausgeblendet statt gelöscht, solange Verzehr darauf verweist
  hidden       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  consumptions Consumption[]

  @@unique([locationId, nameKey])
}

/// Ein Abend einer Gruppe, an dem Verzehr erfasst wird; unabhängig von den Fotos
model Evening {
  id           Int               @id @default(autoincrement())
  groupId      Int
  /// YYYY-MM-DD; mehrere Abende am selben Tag sind möglich
  date         String
  locationId   Int?
  /// Optionale Bezeichnung, z. B. "Firmenfeier"
  label        String?
  /// Besitzer: legt an, gibt zur Zahlung frei und bekommt standardmäßig das Geld
  createdById  Int?
  createdAt    DateTime          @default(now())
  /// "open" (läuft, Positionen bearbeitbar) | "billed" (zur Zahlung freigegeben, gesperrt);
  /// "erledigt" wird nicht gespeichert, sondern ergibt sich aus den Zahlungen
  status       String            @default("open")
  /// Teilnehmer, der die Rechnung bezahlt hat und das Geld bekommt; gesetzt beim Freigeben
  recipientId  Int?
  billedAt     DateTime?
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipient    Player?           @relation("recipient", fields: [recipientId], references: [id], onDelete: Restrict)
  consumptions Consumption[]
  attendees    EveningAttendee[]

  @@index([groupId, date])
}

/// Teilnehmer eines Abends samt Zahlungsstatus
model EveningAttendee {
  eveningId Int
  playerId  Int
  /// Gesetzt, sobald der Anteil als bezahlt markiert ist (vom Teilnehmer selbst oder vom Besitzer)
  paidAt    DateTime?
  /// Betrag beim Abhaken; weicht er vom aktuellen ab, wurde danach noch etwas geändert
  paidCents Int?
  paidById  Int?
  evening   Evening   @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  paidBy    User?     @relation(fields: [paidById], references: [id], onDelete: SetNull)

  @@id([eveningId, playerId])
  @@index([playerId])
}

/// Position an einem Abend: gehört einem Spieler (playerId) oder wird geteilt (playerId null, shares)
model Consumption {
  id            Int                @id @default(autoincrement())
  eveningId     Int
  /// null = geteilte Position, verteilt auf die Spieler in shares
  playerId      Int?
  /// Nur Einzelpositionen hängen an der Karte; geteilte (z. B. Bahnen) haben stattdessen name
  menuItemId    Int?
  /// Name einer geteilten Position, die bewusst nicht auf der Karte steht (Preis jedes Mal anders)
  name          String?
  quantity      Int
  /// Einzelpreis in Cent zum Zeitpunkt des Eintragens (Kopie, unabhängig von späteren Kartenpreisen)
  unitCents     Int
  /// Einzelposition, die in einer geteilten Position steckt (z. B. Leihschuhe in "Bowling"):
  /// wird vor dem Verteilen vom Betrag der geteilten Position abgezogen
  containedInId Int?
  createdAt     DateTime           @default(now())
  evening       Evening            @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  player        Player?            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  menuItem      MenuItem?          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  containedIn   Consumption?       @relation("contained", fields: [containedInId], references: [id], onDelete: SetNull)
  contained     Consumption[]      @relation("contained")
  shares        ConsumptionShare[]

  @@index([eveningId])
  @@index([playerId])
}

/// Wer an einer geteilten Position mitzahlt (zu gleichen Teilen)
model ConsumptionShare {
  consumptionId Int
  playerId      Int
  consumption   Consumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([consumptionId, playerId])
  @@index([playerId])
}
