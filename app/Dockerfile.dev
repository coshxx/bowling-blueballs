# Dev-Image: Quellcode kommt per Bind-Mount, node_modules liegen in Named Volumes.
# Die Verzeichnisse werden hier angelegt, damit die Volumes dem User "node" gehören.
FROM node:22-bookworm

RUN mkdir -p /app/node_modules /app/api/node_modules /app/web/node_modules /data \
  && chown -R node:node /app /data

ENV CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1
USER node
WORKDIR /app
